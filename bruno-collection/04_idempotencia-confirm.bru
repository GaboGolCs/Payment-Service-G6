meta {
  name: 04 Idempotencia — Repetir Confirm (mismo key)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/{{paymentId}}/confirm
  body: none
  auth: none
}

headers {
  Idempotency-Key: confirm-abc-001
}

tests {
  test("Retorna 200 (resultado cacheado)", function() {
    expect(res.status).to.equal(200);
  });
  test("Status sigue APPROVED (no re-procesó)", function() {
    expect(res.body.status).to.equal("APPROVED");
  });
}
