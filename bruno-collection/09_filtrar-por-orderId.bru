meta {
  name: 09 Filtrar Pagos por orderId
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}?orderId=0000000000000000000000
  body: none
  auth: none
}

params:query {
  orderId: 0000000000000000000000
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("Todos los resultados tienen orderId correcto", function() {
    res.body.forEach(function(p) {
      expect(p.orderId).to.equal("order-" + bru.getVar("runId"));
    });
  });
}
