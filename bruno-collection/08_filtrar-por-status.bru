meta {
  name: 08 Filtrar Pagos por Status (APPROVED)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/1235fff7-c159-48e4-aac1-aacb8caa78d6
  body: none
  auth: none
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("Todos los resultados son APPROVED", function() {
    res.body.forEach(function(p) {
      expect(p.status).to.equal("APPROVED");
    });
  });
}
