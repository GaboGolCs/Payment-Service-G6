meta {
  name: 10 Estadísticas de Pagos
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/stats
  body: none
  auth: none
}

tests {
  test("Status 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("Retorna un array", function() {
    expect(res.body).to.be.an("array");
  });
  test("Cada grupo tiene status, _count y _sum", function() {
    res.body.forEach(function(group) {
      expect(group.status).to.be.a("string");
      expect(group._count).to.have.property("id");
      expect(group._sum).to.have.property("amount");
    });
  });
}
